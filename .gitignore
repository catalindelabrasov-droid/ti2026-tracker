__pycache__/
*.pyc
data.json.tmp
.DS_Store
supabase/.temp/

# Signing material must never reach the repo. The Android keystore lives in
# C:\Users\Azog\android-tools\ and losing it means no signed update is
# possible ever again — see ti2026-SIGNING-README.txt next to it.
*.jks
*.keystore
keystore.properties
*.apk
*.aab

# ...except the one APK we publish for sideloading.
!downloads/*.apk

# Snapshot of the auth settings changed for the deletion flow. Local only.
.auth-config-backup.json

# Netlify CLI local state - machine-specific, hardcodes an absolute path.
.netlify/
